rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WAGHAMBA SPORTS HEALTH HUB • PRODUCTION MULTI-TENANT SECURITY RULES v6.2
     * 
     * Enforces strict school/tenant isolation and role-based permissions:
     * - A user can ONLY access records where schoolId/ownerId matches their authenticated UID or their school membership.
     * - Prevents cross-school reads, writes, updates, and deletes.
     * - Prevents changing schoolId across tenants on updates.
     * - Unauthenticated & unauthorized requests are rejected immediately.
     */

    // Authentication Helper
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Direct School Ownership Helper
    function isSchoolOwner(schoolId) {
      return isAuthenticated() && request.auth.uid == schoolId;
    }

    // Document-level Tenant Authorization Check
    function isTenantAuthorized(docData) {
      return isAuthenticated() && (
        docData.schoolId == request.auth.uid ||
        docData.ownerId == request.auth.uid
      );
    }

    // Create Operation Validator: Requires caller's UID to match schoolId/ownerId
    function validTenantCreate(incomingData) {
      return isAuthenticated() && (
        incomingData.schoolId == request.auth.uid ||
        incomingData.ownerId == request.auth.uid
      );
    }

    // Update Operation Validator: Both existing and incoming data must belong to the caller, and schoolId cannot be transferred
    function validTenantUpdate(existingData, incomingData) {
      return isTenantAuthorized(existingData) &&
             validTenantCreate(incomingData) &&
             (!('schoolId' in existingData) || !('schoolId' in incomingData) || existingData.schoolId == incomingData.schoolId) &&
             (!('ownerId' in existingData) || !('ownerId' in incomingData) || existingData.ownerId == incomingData.ownerId);
    }

    // Delete Operation Validator: Must own the existing record
    function validTenantDelete(existingData) {
      return isTenantAuthorized(existingData);
    }

    // 1. School Profiles
    match /schools/{schoolId} {
      allow read: if isSchoolOwner(schoolId);
      allow create: if isSchoolOwner(schoolId) || (isAuthenticated() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isSchoolOwner(schoolId);
      allow delete: if isSchoolOwner(schoolId);
    }

    // 2. School Members & Roles
    match /school_members/{memberId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.schoolId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.schoolId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.schoolId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.schoolId == request.auth.uid;
    }

    // 3. Students & Athletes Roster
    match /players/{playerId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 4. Attendance Registry
    match /attendance_registry/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 5. Fitness Assessments Registry
    match /fitness_registry/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 6. Sports Skills Registry
    match /skills_registry/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 7. Daily Readiness Registry
    match /readiness_registry/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 8. Tactical Events & Performance Registry
    match /tactical_registry/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 9. Health Incidents & Injury Logs
    match /all_health_incidents/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 10. School Activities & Event Logs
    match /school_activities/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 11. Drill Completions
    match /drill_completions/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 12. Goals & Targets
    match /goal_registry/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 13. Report Photos & Evidence Metadata
    match /report_photos/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 14. Daily Activity Summaries
    match /daily_summaries/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 15. Equipment Inventory Stock (Authoritative Firestore)
    match /equipment_inventory/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 16. Equipment Issue & Return Records
    match /equipment_issues/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 17. Equipment Indents & Budget Proposals
    match /equipment_indents/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 18. Daily Practice Schedules
    match /daily_practice_schedules/{docId} {
      allow read: if isTenantAuthorized(resource.data) || isSchoolOwner(resource.data.schoolId);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 19. Auto Practice Master Plans
    match /master_auto_plans/{docId} {
      allow read: if isTenantAuthorized(resource.data) || isSchoolOwner(resource.data.schoolId);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 20. Official Game Rules Registry
    match /game_rules_registry/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 21. Exam & Evaluation Term Configurations
    match /exam_configs/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 22. Monthly Performance Configurations
    match /performance_configs/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 23. Team Plans & Rosters
    match /team_plans/{docId} {
      allow read: if isTenantAuthorized(resource.data);
      allow create: if validTenantCreate(request.resource.data);
      allow update: if validTenantUpdate(resource.data, request.resource.data);
      allow delete: if validTenantDelete(resource.data);
    }

    // 24. Explicit Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
